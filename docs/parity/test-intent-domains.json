[
  {
    "id": "gateway-platform-behavior",
    "upstream_scope": [
      "tests/gateway",
      "gateway/platforms"
    ],
    "local_evidence_globs": [
      "crates/hermes-gateway/src/platforms/*.rs",
      "crates/hermes-cli/tests/e2e_gateway_*.rs"
    ]
  },
  {
    "id": "tool-runtime-behavior",
    "upstream_scope": [
      "tests/tools",
      "tools/environments"
    ],
    "local_evidence_globs": [
