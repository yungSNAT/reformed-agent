model: openrouter:anthropic/claude-sonnet-4.6
max_turns: 90
display:
  skin: mono
  tool_progress: all
fallback_models:
  - openrouter:openai/gpt-5-mini
  - openrouter:openai/gpt-5
future_upstream_section:
  nested_flag: false
  ids:
    - 1
    - 2
    - 3
  note: 'keep: me'
terminal:
  backend: local
  timeout: 180
  cwd: '~/work: main'
