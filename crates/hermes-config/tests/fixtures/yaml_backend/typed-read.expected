TypedCorpus {
    leading_zero: "0123",
    octal: 15,
    hex: 31,
    version_like: "1.10",
    date_like: "2026-11-15",
    yes_word: "yes",
    on_word: "on",
    big_unsigned: 18446744073709551615,
    exponent: 1000.0,
    null_tilde: None,
    null_empty: None,
    env_ref: "${HOME}/data",
    windows_path: "C:\\Users\\example",
    literal_block: "line one\n  indented line\n\nafter blank\n",
    folded_block: "folded line one folded line two\nnew paragraph\n",
    keep_trailing: "kept\n\n",
    strip_trailing: "stripped",
    multiline_quoted: "first line\nsecond line\n",
}
